<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/donut_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/widget_bg"
  android:gravity="center_horizontal"
  android:padding="12dp">

  <!-- Chart area fills available space -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center">

    <ImageView
      android:id="@+id/donut_chart"
      android:layout_width="130dp"
      android:layout_height="130dp"
      android:scaleType="fitCenter" />

    <TextView
      android:id="@+id/donut_expenses_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Expenses"
      android:textColor="#99FFFFFF"
      android:textSize="10sp"
      android:layout_marginTop="4dp" />

    <TextView
      android:id="@+id/donut_expenses"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="$0"
      android:textColor="#CCFFFFFF"
      android:textSize="14sp"
      android:textStyle="bold" />

  </LinearLayout>

  <TextView
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:background="#33FFFFFF"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp" />

  <!-- Remaining displayed at bottom -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="2dp">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Remaining"
      android:textColor="#99FFFFFF"
      android:textSize="9sp" />

    <TextView
      android:id="@+id/donut_remaining"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="$0"
      android:textColor="#FFFFFF"
      android:textSize="16sp"
      android:textStyle="bold" />

  </LinearLayout>

</LinearLayout>
