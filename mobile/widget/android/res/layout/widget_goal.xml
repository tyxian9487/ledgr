<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/goal_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_bg"
  android:orientation="vertical"
  android:padding="12dp">

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Goals"
    android:textColor="#FFFFFF"
    android:textSize="13sp"
    android:textStyle="bold"
    android:layout_marginBottom="8dp" />

  <!-- No goals placeholder: weight=2 so it fills the same space as both goal rows -->
  <TextView
    android:id="@+id/goal_no_goals"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="2"
    android:text="+ Add a Goal"
    android:textColor="#88FFFFFF"
    android:textSize="13sp"
    android:gravity="center"
    android:visibility="gone" />

  <!-- Monthly savings section (upper 2×1 row) -->
  <LinearLayout
    android:id="@+id/goal_monthly_section"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical"
    android:background="@drawable/widget_goal_row_bg"
    android:padding="8dp"
    android:layout_marginBottom="6dp"
    android:visibility="gone">
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Monthly Savings"
      android:textColor="#FFFFFF"
      android:textSize="11sp"
      android:textStyle="bold" />
    <ProgressBar
      android:id="@+id/goal_monthly_progress"
      style="@android:style/Widget.ProgressBar.Horizontal"
      android:layout_width="match_parent"
      android:layout_height="6dp"
      android:layout_marginVertical="4dp"
      android:progressDrawable="@drawable/widget_progress"
      android:max="100"
      android:progress="0" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/goal_monthly_saved"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="$0"
        android:textColor="#BBFFFFFF"
        android:textSize="10sp" />
      <TextView
        android:id="@+id/goal_monthly_target"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="/ $0"
        android:textColor="#66FFFFFF"
        android:textSize="10sp" />
    </LinearLayout>
  </LinearLayout>

  <!-- Add monthly savings placeholder (upper 2×1 row) -->
  <TextView
    android:id="@+id/goal_add_monthly"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:text="+ Add Monthly Goal"
    android:textColor="#66FFFFFF"
    android:textSize="11sp"
    android:gravity="center"
    android:layout_marginBottom="6dp"
    android:visibility="gone" />

  <!-- Custom goal section (lower 2×1 row) -->
  <LinearLayout
    android:id="@+id/goal_custom_section"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical"
    android:background="@drawable/widget_goal_row_bg"
    android:padding="8dp"
    android:visibility="gone">
    <TextView
      android:id="@+id/goal_custom_name"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Goal"
      android:textColor="#FFFFFF"
      android:textSize="11sp"
      android:textStyle="bold" />
    <ProgressBar
      android:id="@+id/goal_custom_progress"
      style="@android:style/Widget.ProgressBar.Horizontal"
      android:layout_width="match_parent"
      android:layout_height="6dp"
      android:layout_marginVertical="4dp"
      android:progressDrawable="@drawable/widget_progress"
      android:max="100"
      android:progress="0" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/goal_custom_saved"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="$0"
        android:textColor="#BBFFFFFF"
        android:textSize="10sp" />
      <TextView
        android:id="@+id/goal_custom_target"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="/ $0"
        android:textColor="#66FFFFFF"
        android:textSize="10sp" />
    </LinearLayout>
  </LinearLayout>

  <!-- Add custom goal placeholder (lower 2×1 row) -->
  <TextView
    android:id="@+id/goal_add_custom"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:text="+ Add Custom Goal"
    android:textColor="#66FFFFFF"
    android:textSize="11sp"
    android:gravity="center"
    android:visibility="gone" />

</LinearLayout>
