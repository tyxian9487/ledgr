# ── Supabase ──────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Receipt scanning (AI) ─────────────────────────────────────────────────────
# Option A — Production: deployed Cloudflare Worker URL (recommended)
# Deploy src/worker.js to Cloudflare and paste the URL here.
# Set ANTHROPIC_API_KEY as a secret in the Cloudflare Worker dashboard.
EXPO_PUBLIC_WORKER_URL=https://ledgr.<your-account>.workers.dev

# Option B — Development: call Anthropic API directly from the app.
# Get your key at https://console.anthropic.com
# WARNING: this key is bundled into the app — use only for local dev/testing.
# EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...

# ── RevenueCat (subscriptions) ────────────────────────────────────────────────
# Get your key from dashboard.revenuecat.com
# Android key starts with goog_, iOS key starts with appl_
EXPO_PUBLIC_REVENUECAT_KEY=
